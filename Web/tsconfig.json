{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"], "strict": true, "declaration": true,
    "outDir": "dist", "rootDir": ".", "noEmitOnError": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "example/**/*.ts"]
}
